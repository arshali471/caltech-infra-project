<tr><td>Capacity range</td><td>0.5 &ndash; 16 ACUs</td></tr>
<tr><td>Storage</td><td>Aurora Standard, KMS encrypted</td></tr>
<tr><td>Logical replication</td><td>Enabled (rds.logical_replication=1)</td></tr>
<tr><td>Max replication slots / WAL senders</td><td>10 / 10</td></tr>
<tr><td>Backup retention</td><td>7 days</td></tr>
<tr><td>Deletion protection</td><td>Enabled</td></tr>
<tr><td>CloudWatch log exports</td><td>postgresql</td></tr>
</table>

